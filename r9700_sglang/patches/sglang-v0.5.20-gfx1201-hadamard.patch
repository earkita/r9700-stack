+@lru_cache(maxsize=8)
+def _gfx1201_hadamard_matrix(hidden_size: int, device: str) -> torch.Tensor:
+    # Correctness fallback for the ROCm image, which does not ship the CUDA
+    # fast_hadamard_transform extension. Keep the matrix on the input device.
+    matrix = torch.tensor(
+        [[1.0 if ((i & j).bit_count() & 1) == 0 else -1.0
+          for j in range(hidden_size)] for i in range(hidden_size)],
+        dtype=torch.float32,
+    )
+    return (matrix * hidden_size**-0.5).to(device)
+
